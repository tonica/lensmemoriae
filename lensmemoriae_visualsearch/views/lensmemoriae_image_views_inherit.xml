<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="lensmemoriae_image_form_visualsearch" model="ir.ui.view">
        <field name="name">lensmemoriae.image.form.visualsearch</field>
        <field name="model">lensmemoriae.image</field>
        <field name="inherit_id" ref="lensmemoriae.lensmemoriae_image_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_build_visual_index"
                    type="object"
                    string="Index Image"
                    class="oe_stat_button"
                    icon="fa-camera"
                    groups="lensmemoriae.group_moderator"
                    invisible="not image"
                />
            </xpath>
            <xpath expr="//group[@name='xml_metadata']" position="before">
                <group string="Visual Search Index" name="visual_search_index">
                    <group>
                        <field name="visual_index_state" widget="statusbar" />
                        <field name="visual_index_date" />
                        <field name="visual_hash_count" />
                    </group>
                    <field
                        name="visual_hash_ids"
                        readonly="1"
                        colspan="2"
                        nolabel="1"
                    >
                        <list create="false" edit="false" delete="false">
                            <field name="kind" string="Kind" />
                            <field name="region" string="Region" />
                            <field name="hash" string="pHash" />
                            <field name="x" string="X" />
                            <field name="y" string="Y" />
                            <field name="width" string="W" />
                            <field name="height" string="H" />
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="lensmemoriae_image_search_visualsearch" model="ir.ui.view">
        <field name="name">lensmemoriae.image.search.visualsearch</field>
        <field name="model">lensmemoriae.image</field>
        <field name="inherit_id" ref="lensmemoriae.lensmemoriae_image_search" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator />
                <filter
                    name="vs_indexed"
                    string="Visual Indexed"
                    domain="[('visual_index_state', '=', 'indexed')]"
                />
                <filter
                    name="vs_pending"
                    string="Visual Pending"
                    domain="[('visual_index_state', '=', 'pending')]"
                />
                <filter
                    name="vs_error"
                    string="Visual Index Error"
                    domain="[('visual_index_state', '=', 'error')]"
                />
            </xpath>
        </field>
    </record>
</odoo>