<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="lensmemoriae_face_identify_form" model="ir.ui.view">
        <field name="name">lensmemoriae.face.identify.form</field>
        <field name="model">lensmemoriae.face.identify</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="face_id" invisible="1" />
                    <field name="person_id" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
