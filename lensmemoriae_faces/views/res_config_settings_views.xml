<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="lensmemoriae_faces_config_settings_view" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.lensmemoriae.faces</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="lensmemoriae.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//app[@name='lensmemoriae']//setting[@id='lensmemoriae_jpeg_quality_setting']"
                position="after"
            >
                <setting
                    id="lensmemoriae_faces_detection_setting"
                    string="Automatic Face Detection"
                    help="Scheduled face scan and person suggestions. Disable to save CPU when the scan is not needed."
                >
                    <field name="lensmemoriae_faces_enabled" />
                    <div class="w-100" invisible="not lensmemoriae_faces_enabled">
                        <label for="lensmemoriae_faces_scan_batch_size" />
                        <field
                            name="lensmemoriae_faces_scan_batch_size"
                            widget="integer"
                        />
                    </div>
                    <div class="w-100" invisible="not lensmemoriae_faces_enabled">
                        <label for="lensmemoriae_faces_suggest_batch_size" />
                        <field
                            name="lensmemoriae_faces_suggest_batch_size"
                            widget="integer"
                        />
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
