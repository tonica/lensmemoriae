<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cron_scan_faces" model="ir.cron">
        <field name="name">LensMemoriae Faces: Scan images for faces</field>
        <field name="model_id" ref="lensmemoriae.model_lensmemoriae_image" />
        <field name="state">code</field>
        <field name="code">model._cron_scan_faces(10)</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
    </record>

    <record id="cron_suggest_persons" model="ir.cron">
        <field name="name">LensMemoriae Faces: Suggest persons for faces</field>
        <field name="model_id" ref="lensmemoriae.model_lensmemoriae_image" />
        <field name="state">code</field>
        <field name="code">model._cron_suggest_persons(50)</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
    </record>
</odoo>
