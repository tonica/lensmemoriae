<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="lensmemoriae_stop_word_action" model="ir.actions.act_window">
        <field name="name">Stop Words</field>
        <field name="res_model">lensmemoriae.stop.word</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="lensmemoriae_stop_word_list" model="ir.ui.view">
        <field name="name">lensmemoriae.stop.word.list</field>
        <field name="model">lensmemoriae.stop.word</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="count" />
                <field name="image_count" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="lensmemoriae_stop_word_form" model="ir.ui.view">
        <field name="name">lensmemoriae.stop.word.form</field>
        <field name="model">lensmemoriae.stop.word</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_recalculate_wordcloud"
                        type="object"
                        string="Recalculate Word Cloud"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="count" />
                        <field name="image_count" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
