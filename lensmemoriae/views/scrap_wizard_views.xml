<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="lensmemoriae_scrap_wizard_view_form" model="ir.ui.view">
        <field name="name">lensmemoriae.scrap.wizard.form</field>
        <field name="model">lensmemoriae.scrap.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="limit" />
                    <field name="filename_filter" placeholder="e.g. ES23011" />
                </group>
                <footer>
                    <button
                        name="action_start_scrap"
                        type="object"
                        string="Start Scrap"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
