<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="signup_form" name="LensMemoriae Signup">
        <t t-call="web.frontend_layout">
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}" />
            <t t-set="body_classname" t-value="'bg-100'" />
            <t t-set="no_header" t-value="True" />
            <t t-set="no_footer" t-value="True" />
            <style>
                body {
                    background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)),
                                url(/lensmemoriae/static/src/img/signup-bg.jpg);
                    background-size: cover;
                    background-position: center;
                    background-attachment: fixed;
                }
                .signup-card {
                    background: rgba(255, 255, 255, 0.95) !important;
                    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
                    border-radius: 12px;
                    max-width: 400px;
                }
            </style>
            <div class="container py-5">
                <div class="card border-0 mx-auto signup-card">
                    <div class="card-body">
                        <div class="text-center pb-3 border-bottom mb-4">
                            <img
                                t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}"
                                alt="Logo"
                                style="max-height:120px; max-width: 100%; width:auto"
                            />
                        </div>
                        <form class="oe_signup_form" role="form" method="post">
                            <input
                                type="hidden"
                                name="csrf_token"
                                t-att-value="request.csrf_token()"
                            />
                            <div
                                style="position:absolute;left:-9999px"
                                aria-hidden="true"
                            >
                                <label for="website">No omplir</label>
                                <input
                                    type="text"
                                    name="website"
                                    id="website"
                                    tabindex="-1"
                                    autocomplete="off"
                                />
                            </div>

                            <div class="mb-3 field-name">
                                <label for="name" class="form-label">Nom</label>
                                <input
                                    type="text"
                                    name="name"
                                    id="name"
                                    t-att-value="name"
                                    class="form-control"
                                    required="required"
                                    placeholder="El teu nom complet"
                                />
                                <p
                                    class="text-danger small"
                                    t-if="errors and errors.get('name')"
                                >
                                    <t t-esc="errors['name']" />
                                </p>
                            </div>

                            <div class="mb-3 field-login">
                                <label
                                    for="login"
                                    class="form-label"
                                >Correu electrònic</label>
                                <input
                                    type="email"
                                    name="login"
                                    id="login"
                                    t-att-value="login"
                                    class="form-control"
                                    required="required"
                                    placeholder="nom@exemple.cat"
                                />
                                <p
                                    class="text-danger small"
                                    t-if="errors and errors.get('login')"
                                >
                                    <t t-esc="errors['login']" />
                                </p>
                            </div>

                            <div class="mb-3 field-password">
                                <label
                                    for="password"
                                    class="form-label"
                                >Contrasenya</label>
                                <input
                                    type="password"
                                    name="password"
                                    id="password"
                                    class="form-control"
                                    required="required"
                                    placeholder="••••••••••"
                                />
                                <p
                                    class="text-danger small"
                                    t-if="errors and errors.get('password')"
                                >
                                    <t t-esc="errors['password']" />
                                </p>
                            </div>

                            <div class="mb-3 field-confirm_password">
                                <label
                                    for="confirm_password"
                                    class="form-label"
                                >Confirma la contrasenya</label>
                                <input
                                    type="password"
                                    name="confirm_password"
                                    id="confirm_password"
                                    class="form-control"
                                    required="required"
                                    placeholder="••••••••••"
                                />
                                <p
                                    class="text-danger small"
                                    t-if="errors and errors.get('confirm_password')"
                                >
                                    <t t-esc="errors['confirm_password']" />
                                </p>
                            </div>

                            <p
                                class="alert alert-danger"
                                t-if="errors and errors.get('general')"
                                role="alert"
                            >
                                <t t-esc="errors['general']" />
                            </p>

                            <div class="text-center oe_login_buttons d-grid pt-3">
                                <button
                                    type="submit"
                                    class="btn btn-primary mb-1"
                                >Crear compte</button>
                                <a
                                    href="/web/login"
                                    class="btn btn-link btn-sm mt-2"
                                    role="button"
                                >Ja tens un compte? Inicia sessió</a>
                            </div>
                        </form>
                        <div class="text-center small mt-4 pt-3 border-top">
                            <a
                                href="https://www.odoo.com"
                                target="_blank"
                            >Powered by <span>Odoo</span></a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
