<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="lensmemoriae_arxiu_fons_wizard_form" model="ir.ui.view">
        <field name="name">lensmemoriae.arxiu.fons.wizard.form</field>
        <field name="model">lensmemoriae.arxiu.fons.wizard</field>
        <field name="arch" type="xml">
            <form string="Descarrega un fons d'Arxius en Línia">
                <group>
                    <field
                        name="fons_name"
                        placeholder="e.g. Alfons Güell, fotògraf"
                    />
                    <field name="result" />
                    <button
                        name="action_show_all_fons"
                        type="object"
                        string="Consulta llista de fons"
                        icon="fa-list"
                        class="btn-link"
                    />
                    <button
                        name="action_refresh_fons_cache"
                        type="object"
                        string="Actualitza llista de fons"
                        icon="fa-refresh"
                        class="btn-link"
                    />
                </group>
                <footer>
                    <button
                        name="action_download"
                        type="object"
                        string="Descarrega"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="lensmemoriae_arxiu_fons_wizard_match_standalone_list" model="ir.ui.view">
        <field name="name">lensmemoriae.arxiu.fons.wizard.match.list</field>
        <field name="model">lensmemoriae.arxiu.fons.wizard.match</field>
        <field name="arch" type="xml">
            <list
                string="Fons disponibles"
                create="false"
                delete="false"
                action="action_download_match"
                type="object"
            >
                <field name="name" />
                <field name="codi_referencia" />
                <button
                    name="action_download_match"
                    type="object"
                    string="Descarrega"
                    icon="fa-download"
                    class="btn-link"
                />
            </list>
        </field>
    </record>
</odoo>
