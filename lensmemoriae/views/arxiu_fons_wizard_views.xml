<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="lensmemoriae_arxiu_fons_wizard_form" model="ir.ui.view">
        <field name="name">lensmemoriae.arxiu.fons.wizard.form</field>
        <field name="model">lensmemoriae.arxiu.fons.wizard</field>
        <field name="arch" type="xml">
            <form string="Descarrega un fons d'Arxius en Línia">
                <group>
                    <field
                        name="fons_name"
                        placeholder="e.g. Alfons Güell, fotògraf"
                    />
                    <button
                        name="action_refresh_fons_cache"
                        type="object"
                        string="Actualitza llista de fons"
                        icon="fa-refresh"
                        class="btn-link"
                    />
                </group>
                <group string="Coincidències" invisible="not matches_ids">
                    <field name="matches_ids">
                        <list>
                            <field name="selected" />
                            <field name="name" />
                            <field name="codi_referencia" />
                        </list>
                    </field>
                    <button
                        name="action_show_all"
                        type="object"
                        string="Mostra llista completa"
                        class="btn-secondary"
                    />
                </group>
                <footer>
                    <button
                        name="action_download"
                        type="object"
                        string="Descarrega"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>