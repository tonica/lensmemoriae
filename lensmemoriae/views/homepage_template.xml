<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="homepage" name="LensMemoriae Homepage">
        <html>
            <head>
                <t
                    t-set="homepage_title"
                    t-value="request.env['ir.config_parameter'].sudo().get_param('lensmemoriae.homepage_title', 'Arxiu fotogràfic històric')"
                />
                <t
                    t-set="homepage_subtitle"
                    t-value="request.env['ir.config_parameter'].sudo().get_param('lensmemoriae.homepage_subtitle', 'Explora el patrimoni visual digitalitzat')"
                />
                <title>LensMemoriae</title>
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <style>
                    body {
                        margin: 0;
                        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
                                    url(/lensmemoriae/static/src/img/signup-bg.jpg);
                        background-size: cover;
                        background-position: center;
                        background-attachment: fixed;
                        font-family: sans-serif;
                        color: white;
                        min-height: 100vh;
                    }
                    .container {
                        max-width: 800px;
                        margin: 30px auto;
                        padding: 0 16px;
                        text-align: center;
                    }
                    .logo {
                        text-align: center;
                        margin-bottom: 16px;
                    }
                    .logo img {
                        max-height: 80px;
                        max-width: 100%;
                        width: auto;
                    }
                    .homepage-card {
                        background: rgba(255, 255, 255, 0.95);
                        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
                        border-radius: 12px;
                        padding: 24px;
                        color: #333;
                    }
                    .homepage-title {
                        font-size: 2rem;
                        font-weight: 700;
                        margin: 0 0 8px;
                    }
                    .homepage-subtitle {
                        font-size: 1rem;
                        color: #666;
                        margin-bottom: 16px;
                    }
                    .btn-group {
                        display: flex;
                        gap: 10px;
                        justify-content: center;
                        flex-wrap: wrap;
                    }
                    .btn {
                        display: inline-block;
                        padding: 12px 24px;
                        border-radius: 8px;
                        text-decoration: none;
                        font-weight: bold;
                        font-size: 1rem;
                        min-width: 140px;
                        text-align: center;
                    }
                    .btn-primary {
                        background: #714B67;
                        color: white;
                    }
                    .btn-outline {
                        border: 2px solid #714B67;
                        color: #714B67;
                    }
                    .carousel {
                        margin-top: 24px;
                    }
                    .carousel-inner {
                        overflow: hidden;
                        border-radius: 8px;
                    }
                    .carousel-item {
                        display: none;
                    }
                    .carousel-item.active {
                        display: block;
                    }
                    .carousel-item img {
                        width: 100%;
                        height: auto;
                        max-height: 500px;
                        object-fit: contain;
                        display: block;
                    }
                    .carousel-caption {
                        display: none;
                    }
                    @media (max-width: 600px) {
                        .container {
                            margin: 16px auto;
                            padding: 0 12px;
                        }
                        .logo img {
                            max-height: 60px;
                        }
                        .homepage-card {
                            padding: 20px 16px;
                            border-radius: 10px;
                        }
                        .homepage-title {
                            font-size: 1.6rem;
                            margin: 0 0 6px;
                        }
                        .homepage-subtitle {
                            font-size: 0.9rem;
                            margin-bottom: 14px;
                        }
                        .btn {
                            padding: 14px 20px;
                            min-width: 120px;
                            font-size: 0.95rem;
                        }
                        .btn-group {
                            flex-direction: column;
                            gap: 8px;
                        }
                        .carousel {
                            margin-top: 16px;
                        }
                    }
                </style>
            </head>
            <body>
                <div class="container">
                    <div class="homepage-card">
                        <div class="logo">
                            <img
                                t-attf-src="/web/binary/company_logo?dbname={{ request.db }}"
                                alt="Logo"
                            />
                        </div>
                        <h1 class="homepage-title"><t t-esc="homepage_title" /></h1>
                        <p class="homepage-subtitle"><t t-esc="homepage_subtitle" /></p>
                        <div class="btn-group">
                            <a
                                href="/web/login"
                                class="btn btn-primary"
                            >Iniciar sessió</a>
                            <a
                                href="/lens-memoriae/signup"
                                class="btn btn-outline"
                            >Crear compte</a>
                        </div>
                    </div>
                    <t t-if="images">
                        <div class="carousel" id="imageCarousel">
                            <div class="carousel-inner">
                                <t t-foreach="images" t-as="img">
                                    <div
                                        t-att-class="'carousel-item active' if img_index == 0 else 'carousel-item'"
                                    >
                                        <img
                                            t-att-src="'/lens-memoriae/public-thumbnail/%s/800x800' % img.public_uid"
                                            t-att-alt="img.name"
                                        />
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
                <script>
                    let currentSlide = 0;
                    const slides = document.querySelectorAll('.carousel-item');
                    function showSlide(index) {
                        slides.forEach((slide, i) => {
                            slide.classList.toggle('active', i === index);
                        });
                    }
                    function nextSlide() {
                        currentSlide = (currentSlide + 1) % slides.length;
                        showSlide(currentSlide);
                    }
                    setInterval(nextSlide, 5000);
                </script>
            </body>
        </html>
    </template>
</odoo>
