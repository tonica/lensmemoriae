<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="lensmemoriae_location_picker_view_form" model="ir.ui.view">
        <field name="name">lensmemoriae.location.picker.form</field>
        <field name="model">lensmemoriae.location.picker</field>
        <field name="arch" type="xml">
            <form>
                <field name="latitude" widget="leaflet_map" nolabel="1" colspan="2" />
                <field name="longitude" invisible="1" />
                <field name="image_id" invisible="1" />
                <footer>
                    <button
                        name="action_save_location"
                        type="object"
                        string="Save"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
