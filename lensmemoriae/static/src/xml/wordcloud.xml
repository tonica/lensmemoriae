<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="lensmemoriae.WordCloud">
        <div class="o_lensmemoriae_wordcloud">
            <div class="o_lensmemoriae_wordcloud_toolbar">
                <t t-if="state.loading">
                    <i class="fa fa-spinner fa-spin" /> Loading…
                </t>
                <t t-else="">
                    <label class="o_lensmemoriae_wordcloud_slider_label">
                        Paraules
                        <input
                            type="range"
                            min="1"
                            t-att-max="state.totalWords"
                            t-att-value="state.wordLimit"
                            t-on-input="onLimitChange"
                            class="o_lensmemoriae_wordcloud_slider"
                        />
                    </label>
                    <span class="o_lensmemoriae_wordcloud_count">
                        <t t-esc="state.wordLimit" /> de <t t-esc="state.totalWords" />
                    </span>
                </t>
            </div>
            <div class="o_lensmemoriae_wordcloud_body">
                <canvas
                    t-ref="canvas"
                    t-on-click="onClick"
                    t-on-mousemove="onHover"
                    t-on-mouseleave="onLeave"
                    class="o_lensmemoriae_wordcloud_canvas"
                />
                <div
                    t-if="state.hovered"
                    class="o_lensmemoriae_wordcloud_tooltip"
                    t-att-style="'left:' + state.tooltipX + 'px;top:' + state.tooltipY + 'px'"
                >
                    <strong><t t-esc="state.hovered.word" /></strong>
                    — <t t-esc="state.hovered.count" /> imatges
                </div>
            </div>
        </div>
    </t>
</templates>
